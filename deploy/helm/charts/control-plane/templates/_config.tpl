{{/*
根据 .Values.config 渲染控制面 TOML。

字符串使用 toJson 转义，保证引号、反斜杠和换行在 TOML basic string 中合法；
整数使用 int64，避免大整数被渲染成浮点科学计数法（例如 8388608 变成
8.388608e+06），导致服务按 float 解析后类型校验失败。
*/}}
{{- define "control-plane.configToml" -}}
# Generated by the control-plane Helm chart from values.config.
env = {{ .Values.config.env | default "production" | toJson }}

[test_run_notifications]
redis_url = {{ .Values.config.test_run_notifications.redis_url | default "" | toJson }}

[http]
host = {{ .Values.config.http.host | default "0.0.0.0" | toJson }}
port = {{ int64 .Values.config.http.port }}

[security.jwt]
key = {{ .Values.config.security.jwt.key | default "" | toJson }}
expire_hours = {{ int64 .Values.config.security.jwt.expire_hours }}
user_expire_hours = {{ int64 .Values.config.security.jwt.user_expire_hours }}
super_admin_expire_hours = {{ int64 .Values.config.security.jwt.super_admin_expire_hours }}

[security.super_admin]
username = {{ .Values.config.security.super_admin.username | default "" | toJson }}
email = {{ .Values.config.security.super_admin.email | default "" | toJson }}
initial_password = {{ .Values.config.security.super_admin.initial_password | default "" | toJson }}

[security.login]
max_failures = {{ int64 .Values.config.security.login.max_failures }}
lock_minutes = {{ int64 .Values.config.security.login.lock_minutes }}
rate_limit_window_minutes = {{ int64 .Values.config.security.login.rate_limit_window_minutes }}

[security.integration]
key = {{ .Values.config.security.integration.key | default "" | toJson }}

[security.worker]
key = {{ .Values.config.security.worker.key | default "" | toJson }}

[security.integration_worker]
key = {{ .Values.config.security.integration_worker.key | default "" | toJson }}

[integration_execution]
enabled = {{ .Values.config.integration_execution.enabled | default false }}
project_ids = [{{ range $i, $id := .Values.config.integration_execution.project_ids }}{{ if $i }}, {{ end }}{{ $id | default "" | toJson }}{{ end }}]
all_projects = {{ .Values.config.integration_execution.all_projects | default false }}
accept_submissions = {{ .Values.config.integration_execution.accept_submissions }}
claim_enabled = {{ .Values.config.integration_execution.claim_enabled }}
lease_seconds = {{ int64 .Values.config.integration_execution.lease_seconds }}
runtime_generation = {{ .Values.config.integration_execution.runtime_generation | default "" | toJson }}
succeeded_retention_days = {{ int64 .Values.config.integration_execution.succeeded_retention_days }}
failed_retention_days = {{ int64 .Values.config.integration_execution.failed_retention_days }}
claim_receipt_retention_days = {{ int64 .Values.config.integration_execution.claim_receipt_retention_days }}
maintenance_batch_size = {{ int64 .Values.config.integration_execution.maintenance_batch_size }}
restore_review_max_age_seconds = {{ int64 .Values.config.integration_execution.restore_review_max_age_seconds }}
worker_presence_ttl_seconds = {{ int64 .Values.config.integration_execution.worker_presence_ttl_seconds }}

[data.db.user]
driver = {{ .Values.config.data.db.user.driver | default "mysql" | toJson }}
pool_size = {{ int64 .Values.config.data.db.user.pool_size }}
max_overflow = {{ int64 .Values.config.data.db.user.max_overflow }}
dsn = {{ .Values.config.data.db.user.dsn | default "" | toJson }}

[storage.s3]
enabled = {{ .Values.config.storage.s3.enabled | default false }}
endpoint = {{ .Values.config.storage.s3.endpoint | default "" | toJson }}
region = {{ .Values.config.storage.s3.region | default "us-east-1" | toJson }}
bucket = {{ .Values.config.storage.s3.bucket | default "" | toJson }}
access_key = {{ .Values.config.storage.s3.access_key | default "" | toJson }}
secret_key = {{ .Values.config.storage.s3.secret_key | default "" | toJson }}
prefix = {{ .Values.config.storage.s3.prefix | default "mtx" | toJson }}
addressing_style = {{ .Values.config.storage.s3.addressing_style | default "path" | toJson }}
signature_seconds = {{ int64 .Values.config.storage.s3.signature_seconds }}
temporary_hours = {{ int64 .Values.config.storage.s3.temporary_hours }}
max_bytes = {{ int64 .Values.config.storage.s3.max_bytes }}

[code_overview]
cache_ttl_seconds = {{ int64 .Values.config.code_overview.cache_ttl_seconds }}

[asset_import]
max_bytes = {{ int64 .Values.config.asset_import.max_bytes }}
max_items = {{ int64 .Values.config.asset_import.max_items }}
max_field_chars = {{ int64 .Values.config.asset_import.max_field_chars }}
max_depth = {{ int64 .Values.config.asset_import.max_depth }}
max_nodes = {{ int64 .Values.config.asset_import.max_nodes }}
max_concurrent = {{ int64 .Values.config.asset_import.max_concurrent }}
{{- end -}}
