{{/*
根据 .Values.config 渲染 ai-worker TOML。

字符串使用 toJson 转义；整数使用 int64，浮点数使用 float64，避免大整数被
渲染成浮点科学计数法。agent 只渲染 backend 选中的子配置。
*/}}
{{- define "ai-worker.configToml" -}}
{{- $backend := .Values.config.agent.backend | default "pi" -}}
{{- if not (has $backend (list "nanobot" "pi")) -}}
{{- fail "config.agent.backend must be nanobot or pi" -}}
{{- end -}}
# Generated by the ai-worker Helm chart from values.config.

[worker]
worker_id = {{ .Values.config.worker.worker_id | default "ai-worker" | toJson }}
poll_interval_seconds = {{ int64 .Values.config.worker.poll_interval_seconds }}
heartbeat_interval_seconds = {{ int64 .Values.config.worker.heartbeat_interval_seconds }}
max_concurrent_tasks = {{ int64 .Values.config.worker.max_concurrent_tasks }}
run_once = {{ .Values.config.worker.run_once }}

[platform]
base_url = {{ .Values.config.platform.base_url | default "http://control-plane:9000" | toJson }}
worker_token = {{ .Values.config.platform.worker_token | default "" | toJson }}
task_claim_path = {{ .Values.config.platform.task_claim_path | default "/internal/ai-worker/tasks/claim" | toJson }}
task_snapshot_path = {{ .Values.config.platform.task_snapshot_path | default "/internal/ai-worker/tasks/{task_id}/snapshot" | toJson }}
task_started_path = {{ .Values.config.platform.task_started_path | default "/internal/ai-worker/tasks/{task_id}/started" | toJson }}
task_heartbeat_path = {{ .Values.config.platform.task_heartbeat_path | default "/internal/ai-worker/tasks/{task_id}/heartbeat" | toJson }}
task_progress_path = {{ .Values.config.platform.task_progress_path | default "/internal/ai-worker/tasks/{task_id}/progress" | toJson }}
task_completed_path = {{ .Values.config.platform.task_completed_path | default "/internal/ai-worker/tasks/{task_id}/completed" | toJson }}
task_llm_credentials_path = {{ .Values.config.platform.task_llm_credentials_path | default "/internal/ai-worker/tasks/{task_id}/llm-credentials" | toJson }}
request_timeout_seconds = {{ float64 .Values.config.platform.request_timeout_seconds }}

[agent]
backend = {{ $backend | toJson }}
{{ if eq $backend "pi" }}
[agent.pi]
runtime_root = {{ .Values.config.agent.pi.runtime_root | default "/data/runtime" | toJson }}
stream_idle_timeout_seconds = {{ float64 .Values.config.agent.pi.stream_idle_timeout_seconds }}
executable = {{ .Values.config.agent.pi.executable | default "pi" | toJson }}
run_timeout_seconds = {{ float64 .Values.config.agent.pi.run_timeout_seconds }}
api = {{ .Values.config.agent.pi.api | default "openai-completions" | toJson }}
context_window_tokens = {{ int64 .Values.config.agent.pi.context_window_tokens }}
max_output_tokens = {{ int64 .Values.config.agent.pi.max_output_tokens }}
reasoning = {{ .Values.config.agent.pi.reasoning }}
thinking_level = {{ .Values.config.agent.pi.thinking_level | default "off" | toJson }}
{{ else }}
[agent.nanobot]
runtime_root = {{ .Values.config.agent.nanobot.runtime_root | default "/data/runtime" | toJson }}
stream_idle_timeout_seconds = {{ float64 .Values.config.agent.nanobot.stream_idle_timeout_seconds }}
{{ with .Values.config.agent.nanobot.provider_request_timeout_seconds }}
provider_request_timeout_seconds = {{ float64 . }}
{{ end }}
{{ end }}
[code_risk_analysis]
gitlab_timeout_seconds = {{ float64 .Values.config.code_risk_analysis.gitlab_timeout_seconds }}
git_timeout_seconds = {{ float64 .Values.config.code_risk_analysis.git_timeout_seconds }}
workspace_retention_hours = {{ float64 .Values.config.code_risk_analysis.workspace_retention_hours }}
max_diff_chars = {{ int64 .Values.config.code_risk_analysis.max_diff_chars }}
max_repos = {{ int64 .Values.config.code_risk_analysis.max_repos }}

[repository_profile]
git_timeout_seconds = {{ float64 .Values.config.repository_profile.git_timeout_seconds }}
workspace_retention_hours = {{ float64 .Values.config.repository_profile.workspace_retention_hours }}
max_repos = {{ int64 .Values.config.repository_profile.max_repos }}
max_output_chars = {{ int64 .Values.config.repository_profile.max_output_chars }}

[ui_generation]
git_timeout_seconds = {{ float64 .Values.config.ui_generation.git_timeout_seconds }}
workspace_retention_hours = {{ float64 .Values.config.ui_generation.workspace_retention_hours }}
max_repo_size_mb = {{ float64 .Values.config.ui_generation.max_repo_size_mb }}
max_repo_files = {{ int64 .Values.config.ui_generation.max_repo_files }}

[logging]
level = {{ .Values.config.logging.level | default "INFO" | toJson }}
console = {{ .Values.config.logging.console }}
dir = {{ .Values.config.logging.dir | default "/app/logs" | toJson }}
filename = {{ .Values.config.logging.filename | default "worker.log" | toJson }}
retention_days = {{ int64 .Values.config.logging.retention_days }}
{{- end -}}
