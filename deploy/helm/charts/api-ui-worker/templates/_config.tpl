{{/*
根据 .Values.config 渲染 api-ui-worker TOML。

字符串使用 toJson 转义；整数使用 int64，避免大整数被渲染成浮点科学计数法。
*/}}
{{- define "api-ui-worker.configToml" -}}
# Generated by the api-ui-worker Helm chart from values.config.
mode = {{ .Values.config.mode | default "poll" | toJson }}

[control_plane]
base_url = {{ .Values.config.control_plane.base_url | default "http://control-plane:9000" | toJson }}
worker_token = {{ .Values.config.control_plane.worker_token | default "" | toJson }}

[notifications]
redis_url = {{ .Values.config.notifications.redis_url | default "" | toJson }}

[worker]
id = {{ .Values.config.worker.id | default "" | toJson }}
poll_interval_ms = {{ int64 .Values.config.worker.poll_interval_ms }}
request_timeout_ms = {{ int64 .Values.config.worker.request_timeout_ms }}
heartbeat_interval_ms = {{ int64 .Values.config.worker.heartbeat_interval_ms }}

[ui]
artifacts_dir = {{ .Values.config.ui.artifacts_dir | default "/app/artifacts" | toJson }}
headless = {{ .Values.config.ui.headless }}
slow_mo_ms = {{ int64 .Values.config.ui.slow_mo_ms }}
trace_enabled = {{ .Values.config.ui.trace_enabled }}
screenshot_on_failure = {{ .Values.config.ui.screenshot_on_failure }}

[once]
snapshot_file = {{ .Values.config.once.snapshot_file | default "" | toJson }}
{{- end -}}
