{{/*
根据 .Values.config 渲染 integration-worker TOML。

字符串使用 toJson 转义；整数使用 int64，浮点数使用 float64。
*/}}
{{- define "integration-worker.configToml" -}}
# Generated by the integration-worker Helm chart from values.config.

[control_plane]
base_url = {{ .Values.config.control_plane.base_url | default "http://control-plane:9000" | toJson }}
worker_token = {{ .Values.config.control_plane.worker_token | default "" | toJson }}
timeout_seconds = {{ float64 .Values.config.control_plane.timeout_seconds }}
retry_attempts = {{ int64 .Values.config.control_plane.retry_attempts }}

[worker]
poll_interval_seconds = {{ float64 .Values.config.worker.poll_interval_seconds }}
heartbeat_interval_seconds = {{ float64 .Values.config.worker.heartbeat_interval_seconds }}
lease_margin_seconds = {{ float64 .Values.config.worker.lease_margin_seconds }}
shutdown_grace_seconds = {{ float64 .Values.config.worker.shutdown_grace_seconds }}
health_file = {{ .Values.config.worker.health_file | default "/app/runtime/health.json" | toJson }}
evidence_file = {{ .Values.config.worker.evidence_file | default "/app/runtime/evidence.json" | toJson }}
health_max_age_seconds = {{ float64 .Values.config.worker.health_max_age_seconds }}
{{- end -}}
