{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:organize-requirement-material:0.2",
  "title": "Readable requirement material",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "title",
    "sources",
    "materialBlocks",
    "functions",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "artifactType": {
      "const": "readable_requirement_material"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "materialBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "location"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "document",
            "richtext",
            "image",
            "user_confirmation"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "parentId",
        "kind",
        "locator",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "section",
            "paragraph",
            "list",
            "table",
            "image"
          ]
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "content": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "section",
                  "paragraph"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rows"
                ],
                "properties": {
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "spans": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "row",
                        "column",
                        "rowSpan",
                        "columnSpan"
                      ],
                      "properties": {
                        "row": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "column": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "rowSpan": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "columnSpan": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "description",
                  "visibleText",
                  "readStatus"
                ],
                "properties": {
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "visibleText": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "readStatus": {
                    "enum": [
                      "complete",
                      "partial",
                      "unreadable"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "items"
      ],
      "properties": {
        "title": {
          "enum": [
            "功能目标与背景",
            "页面入口",
            "功能使用与业务规则",
            "完整业务流程"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "minItems": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status",
        "materialBlockIds"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "conflicting",
            "example"
          ]
        },
        "materialBlockIds": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "reason",
        "materialBlockIds",
        "functionIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "materialBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "functionIds": {
          "$ref": "#/$defs/ids"
        }
      }
    }
  }
}
