{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactType": {
      "const": "requirement_understanding"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "functionalOverview": {
      "type": "object",
      "properties": {
        "purpose": {
          "$ref": "#/$defs/textFact"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "explicitExclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        }
      },
      "required": [
        "purpose",
        "scope",
        "actors",
        "explicitExclusions"
      ],
      "additionalProperties": false
    },
    "businessFlows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/businessFlow"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/businessRule"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "title",
    "sources",
    "functionalOverview",
    "businessFlows",
    "modules",
    "businessRules",
    "questions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "需求理解产物 1.0",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "document",
            "text",
            "prototype",
            "screenshot",
            "design",
            "user_confirmation",
            "example"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "location",
        "version"
      ],
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "locator",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ],
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "minLength": 1
              }
            }
          ]
        },
        "confirmationStatus": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "conflicting",
            "example",
            "not_applicable"
          ]
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "value",
        "confirmationStatus",
        "sourceReferences",
        "relatedQuestionIds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmationStatus": {
                "enum": [
                  "confirmed",
                  "example",
                  "not_applicable",
                  "conflicting"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sourceReferences": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmationStatus": {
                "const": "conflicting"
              }
            }
          },
          "then": {
            "properties": {
              "relatedQuestionIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmationStatus": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "confirmationStatus": {
                "enum": [
                  "unconfirmed",
                  "conflicting",
                  "not_applicable"
                ]
              }
            }
          }
        }
      ]
    },
    "textFact": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "scalarFact": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "affectedRef": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "module",
            "operation",
            "control",
            "rule",
            "flow",
            "entry",
            "block",
            "extracted_fact",
            "requirement"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "properties": {
        "stage": {
          "enum": [
            "extraction",
            "understanding",
            "test_points",
            "test_cases",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "description",
        "blocking"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "open"
        },
        "affectedRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/affectedRef"
          },
          "minItems": 1
        },
        "impacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/impact"
          },
          "minItems": 1
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "type": "null"
            }
          ],
          "description": "剩余问题所需的部分答复；完整答复合并到正文后移除整个问题，不保留问答历史。"
        }
      },
      "required": [
        "id",
        "question",
        "status",
        "affectedRefs",
        "impacts",
        "sourceReferences",
        "answer"
      ],
      "additionalProperties": false,
      "description": "只记录尚未解决的缺口。明确答复先合并到受影响业务内容，再删除已解决问题及全部关联引用；部分解决仅保留剩余缺口。"
    },
    "entryPoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/textFact"
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        }
      },
      "required": [
        "id",
        "path",
        "actors",
        "conditions"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/scalarFact"
        },
        "meaning": {
          "$ref": "#/$defs/textFact"
        }
      },
      "required": [
        "id",
        "value",
        "meaning"
      ],
      "additionalProperties": false
    },
    "optionCompleteness": {
      "allOf": [
        {
          "$ref": "#/$defs/textFact"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable",
                null
              ]
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/textFact"
        },
        "businessMeaning": {
          "$ref": "#/$defs/textFact"
        },
        "type": {
          "$ref": "#/$defs/textFact"
        },
        "options": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              }
            },
            "completeness": {
              "$ref": "#/$defs/optionCompleteness"
            }
          },
          "required": [
            "items",
            "completeness"
          ],
          "additionalProperties": false
        },
        "inputRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "defaultValue": {
          "$ref": "#/$defs/fact"
        }
      },
      "required": [
        "id",
        "label",
        "businessMeaning",
        "type",
        "options",
        "inputRules",
        "defaultValue"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "properties": {
        "location": {
          "$ref": "#/$defs/textFact"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "recordIdentity": {
          "$ref": "#/$defs/textFact"
        },
        "scope": {
          "$ref": "#/$defs/textFact"
        },
        "emptyState": {
          "$ref": "#/$defs/textFact"
        }
      },
      "required": [
        "location",
        "fields",
        "recordIdentity",
        "scope",
        "emptyState"
      ],
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "trigger": {
          "$ref": "#/$defs/textFact"
        },
        "initialState": {
          "$ref": "#/$defs/textFact"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "results": {
          "$ref": "#/$defs/results"
        },
        "pagination": {
          "$ref": "#/$defs/textFact"
        },
        "sorting": {
          "$ref": "#/$defs/textFact"
        },
        "validationAndFeedback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        }
      },
      "required": [
        "controls",
        "trigger",
        "initialState",
        "dependencies",
        "results",
        "pagination",
        "sorting",
        "validationAndFeedback"
      ],
      "additionalProperties": false
    },
    "operationStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "$ref": "#/$defs/textFact"
        },
        "action": {
          "$ref": "#/$defs/textFact"
        },
        "systemResponse": {
          "$ref": "#/$defs/textFact"
        }
      },
      "required": [
        "id",
        "actor",
        "action",
        "systemResponse"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "$ref": "#/$defs/textFact"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationStep"
          }
        },
        "interaction": {
          "$ref": "#/$defs/interaction"
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "goal",
        "preconditions",
        "steps",
        "interaction",
        "ruleIds",
        "relatedQuestionIds"
      ],
      "additionalProperties": false
    },
    "moduleFlowStep": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "$ref": "#/$defs/textFact"
        }
      },
      "required": [
        "operationId",
        "note"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "$ref": "#/$defs/textFact"
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryPoint"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "userVisibleFlow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleFlowStep"
          }
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "entryPoints",
        "operations",
        "userVisibleFlow",
        "relatedQuestionIds"
      ],
      "additionalProperties": false
    },
    "nextStep": {
      "type": "object",
      "properties": {
        "stepId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/textFact"
        }
      },
      "required": [
        "stepId",
        "condition"
      ],
      "additionalProperties": false
    },
    "flowStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nextStep"
          }
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "moduleId",
        "operationId",
        "nextSteps",
        "relatedQuestionIds"
      ],
      "additionalProperties": false
    },
    "businessFlow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowStep"
          },
          "minItems": 1
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "moduleIds",
        "steps",
        "relatedQuestionIds"
      ],
      "additionalProperties": false
    },
    "businessRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "operationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          }
        },
        "trigger": {
          "$ref": "#/$defs/textFact"
        },
        "expectedBehavior": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textFact"
          },
          "minItems": 1
        },
        "observableOutcome": {
          "$ref": "#/$defs/textFact"
        },
        "relatedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "moduleIds",
        "operationIds",
        "preconditions",
        "trigger",
        "expectedBehavior",
        "observableOutcome",
        "relatedQuestionIds"
      ],
      "additionalProperties": false
    }
  }
}
