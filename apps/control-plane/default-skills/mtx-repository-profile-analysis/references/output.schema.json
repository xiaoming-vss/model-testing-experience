{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositories", "overallSummary"],
  "properties": {
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repositoryId",
          "pathWithNamespace",
          "role",
          "responsibilitySummary",
          "techStack",
          "keyPaths",
          "confidence",
          "evidence"
        ],
        "properties": {
          "repositoryId": {"type": "string", "minLength": 1},
          "pathWithNamespace": {"type": "string", "minLength": 1},
          "role": {"enum": ["frontend", "backend", "fullstack", "infra", "test", "unknown"]},
          "responsibilitySummary": {"type": "string", "minLength": 1, "maxLength": 120},
          "techStack": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1}},
          "keyPaths": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "overallSummary": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
