{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:analyze-functional-requirements:1.0",
  "title": "Test objects, business impact and risk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "testObjects",
    "impactAreas",
    "risks",
    "openQuestions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactType": {
      "const": "test_scope_impact_risk"
    },
    "testObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testObject"
      }
    },
    "impactAreas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactArea"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "testObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceBlockIds",
        "basisStatus",
        "name",
        "type",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "basisStatus": {
          "enum": [
            "confirmed",
            "inferred",
            "unconfirmed"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basisStatus": {
                "enum": [
                  "confirmed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sourceBlockIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "impactArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceBlockIds",
        "basisStatus",
        "testObjectIds",
        "area",
        "impact"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "basisStatus": {
          "enum": [
            "confirmed",
            "inferred",
            "unconfirmed"
          ]
        },
        "testObjectIds": {
          "$ref": "#/$defs/ids"
        },
        "area": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basisStatus": {
                "enum": [
                  "confirmed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sourceBlockIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceBlockIds",
        "basisStatus",
        "testObjectIds",
        "impactAreaIds",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "basisStatus": {
          "enum": [
            "confirmed",
            "inferred",
            "unconfirmed"
          ]
        },
        "testObjectIds": {
          "$ref": "#/$defs/ids"
        },
        "impactAreaIds": {
          "$ref": "#/$defs/ids"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basisStatus": {
                "enum": [
                  "confirmed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sourceBlockIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "testObjectIds",
        "impactAreaIds",
        "riskIds",
        "sourceBlockIds",
        "sourceQuestionIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "testObjectIds": {
          "$ref": "#/$defs/ids"
        },
        "impactAreaIds": {
          "$ref": "#/$defs/ids"
        },
        "riskIds": {
          "$ref": "#/$defs/ids"
        },
        "sourceBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "sourceQuestionIds": {
          "$ref": "#/$defs/ids"
        }
      }
    }
  }
}
