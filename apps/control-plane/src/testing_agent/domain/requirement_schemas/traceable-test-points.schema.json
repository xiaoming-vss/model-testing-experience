{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:generate-traceable-test-points:1.0",
  "title": "Traceable test points",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "reviewStatus",
    "testPoints",
    "coverageGaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactType": {
      "const": "traceable_test_points"
    },
    "testPoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "coverageGaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "reviewStatus": {
      "enum": [
        "independent_reviewed",
        "self_review_only",
        "independent_review_failed"
      ]
    },
    "reviewIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewIssue"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "dimension",
        "name",
        "basis",
        "materialBlockIds",
        "testObjectIds",
        "impactAreaIds",
        "riskIds",
        "materialQuestionIds",
        "scopeQuestionIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "module": {
          "$ref": "#/$defs/text"
        },
        "dimension": {
          "enum": [
            "功能场景",
            "异常/容错场景",
            "用户体验场景",
            "兼容性场景",
            "权限与渠道场景",
            "数据与一致性场景",
            "边界场景",
            "时序与并发场景",
            "性能场景",
            "长稳场景",
            "安全场景"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "basis": {
          "enum": [
            "direct",
            "derived"
          ]
        },
        "materialBlockIds": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "minItems": 1
            }
          ]
        },
        "testObjectIds": {
          "$ref": "#/$defs/ids"
        },
        "impactAreaIds": {
          "$ref": "#/$defs/ids"
        },
        "riskIds": {
          "$ref": "#/$defs/ids"
        },
        "materialQuestionIds": {
          "$ref": "#/$defs/ids"
        },
        "scopeQuestionIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "blockedCoverage",
        "materialBlockIds",
        "testObjectIds",
        "impactAreaIds",
        "riskIds",
        "materialQuestionIds",
        "scopeQuestionIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "blockedCoverage": {
          "$ref": "#/$defs/text"
        },
        "materialBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "testObjectIds": {
          "$ref": "#/$defs/ids"
        },
        "impactAreaIds": {
          "$ref": "#/$defs/ids"
        },
        "riskIds": {
          "$ref": "#/$defs/ids"
        },
        "materialQuestionIds": {
          "$ref": "#/$defs/ids"
        },
        "scopeQuestionIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "reviewIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "targetType",
        "targetId",
        "issue",
        "suggestion",
        "materialBlockIds",
        "testObjectIds",
        "impactAreaIds",
        "riskIds",
        "materialQuestionIds",
        "scopeQuestionIds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unsupported",
            "missing",
            "granularity",
            "classification"
          ]
        },
        "targetType": {
          "enum": [
            "testPoint",
            "coverageGap",
            "missing"
          ]
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "$ref": "#/$defs/text"
        },
        "suggestion": {
          "$ref": "#/$defs/text"
        },
        "materialBlockIds": {
          "$ref": "#/$defs/ids"
        },
        "testObjectIds": {
          "$ref": "#/$defs/ids"
        },
        "impactAreaIds": {
          "$ref": "#/$defs/ids"
        },
        "riskIds": {
          "$ref": "#/$defs/ids"
        },
        "materialQuestionIds": {
          "$ref": "#/$defs/ids"
        },
        "scopeQuestionIds": {
          "$ref": "#/$defs/ids"
        }
      }
    }
  }
}
